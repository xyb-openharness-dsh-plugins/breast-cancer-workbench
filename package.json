{
  "name": "@pinkypal-dsh/breast-cancer-workbench",
  "version": "0.5.1",
  "description": "小粉宝：本机优先的乳腺癌病程整理与就诊准备工作台",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./version": "./lib/version.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "assets",
    "dsh",
    "lib",
    "public",
    "schema",
    "scripts",
    "cordis.patch.yml",
    "workbench.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:version": "node scripts/build-version.mjs",
    "build:client": "node scripts/build-client.mjs",
    "start": "node scripts/dev-server.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check": "node scripts/build-version.mjs --check && node scripts/check-syntax.mjs && node scripts/check-schema.mjs && node scripts/check-wording.mjs && node scripts/check-secrets.mjs && node scripts/build-client.mjs --check && node --disable-warning=ExperimentalWarning --test test/*.test.mjs && node scripts/check-package.mjs && node scripts/check-version.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/xfb-workbench"
  },
  "license": "MIT"
}
